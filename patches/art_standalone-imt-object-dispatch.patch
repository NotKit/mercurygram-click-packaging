     return HandleInvoke(invoke, operands, shorty, /* is_unresolved= */ true);
   }
 
+  // An invoke-interface can resolve to a java.lang.Object method (toString,
+  // hashCode, equals called through an interface reference). Object methods
+  // have no IMT slot: the slot the hash lands on holds the runtime's shared
+  // "unimplemented" method, and the conflict trampoline then caches the first
+  // resolution in that shared method's table, so every later receiver of any
+  // class is dispatched to it. Emit a virtual call instead, as upstream does;
+  // Object's vtable indices are the same in every class.
+  if (invoke_type == kInterface) {
+    ScopedObjectAccess soa(Thread::Current());
+    if (resolved_method->GetDeclaringClass()->IsObjectClass()) {
+      invoke_type = kVirtual;
+    }
+  }
+
   // Replace calls to String.<init> with StringFactory.
